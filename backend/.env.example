# Leave MONGO_URI empty to use the built-in TinyDB document store (backend/data/documents.json).
# Set it to use MongoDB, for example mongodb://localhost:27017 or an Atlas connection string.
MONGO_URI=
MONGO_DB=climate_hazard
# auto | mongo | tinydb
STORE_PREFERENCE=auto
CORS_ORIGINS=http://localhost:43123,http://127.0.0.1:43123
TRUST_PROXY=false
